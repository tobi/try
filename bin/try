#!/usr/bin/env ruby
root = File.expand_path('..', __dir__)
native = File.join(root, 'dist', 'try')
script = File.join(root, 'dist', 'try.rb')
if File.file?(native) && File.executable?(native)
  exec native, *ARGV
end
abort "try: missing #{script} (run: make dist)" unless File.file?(script)
load script
